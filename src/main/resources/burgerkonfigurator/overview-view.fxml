<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="burgerkonfigurator.controller.OverviewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Meine Burger" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TableView fx:id="burgerTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="170.0" text="Name"/>
            <TableColumn fx:id="bunColumn" prefWidth="90.0" text="Brot"/>
            <TableColumn fx:id="pattyColumn" prefWidth="80.0" text="Patty"/>
            <TableColumn fx:id="cheeseColumn" prefWidth="100.0" text="Käse"/>
            <TableColumn fx:id="sauceColumn" prefWidth="90.0" text="Sauce"/>
            <TableColumn fx:id="toppingsColumn" prefWidth="220.0" text="Gemüse &amp; Extras"/>
            <TableColumn fx:id="priceColumn" prefWidth="80.0" text="Preis"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="editButton" onAction="#onEdit" text="Bearbeiten"/>
        <Button fx:id="deleteButton" onAction="#onDelete" text="Löschen"/>
    </HBox>
</VBox>
